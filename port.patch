+# ============================================================================
+# 小宇专属版 Folia iOS —— 云端编译未签名 IPA
+# 基于官方 folia-major 0.7.29 + iOS 原生直连层（零后端可听歌）
+# 产物为未签名 IPA：TrollStore 直接装，或 Sideloadly/AltStore 自签。
+# ============================================================================
+name: Build 小宇Folia IPA
+
+on:
+  push:
+    branches: [main, master]
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+env:
+  XCODE_PATH: /Applications/Xcode_16.4.app
+  NODE_VERSION: 24
+
+jobs:
+  build:
+    name: Build unsigned IPA
+    runs-on: macos-15
+    timeout-minutes: 90
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: 环境
+        run: |
+          sw_vers
+          xcodebuild -version
+
+      - name: 选择 Xcode
+        run: sudo xcode-select -s "$XCODE_PATH"
+
+      - name: 安装 Node ${{ env.NODE_VERSION }}
+        uses: actions/setup-node@v4
+        with:
+          node-version: ${{ env.NODE_VERSION }}
+
+      - name: 安装 Web 依赖
+        run: |
+          export ELECTRON_SKIP_BINARY_DOWNLOAD=1
+          export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
+          if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi
+
+      - name: 构建 Vite Web 产物（dist）
+        run: npx vite build
+
+      - name: 同步 Web 产物到 iOS 工程
+        run: npx cap sync ios
+
+      - name: 无签名归档
+        run: |
+          set -euo pipefail
+          ARCHIVE="$RUNNER_TEMP/build/App.xcarchive"
+          xcodebuild archive \
+            -project ios/App/App.xcodeproj \
+            -scheme App \
+            -configuration Release \
+            -destination 'generic/platform=iOS' \
+            -archivePath "$ARCHIVE" \
+            -derivedDataPath "$RUNNER_TEMP/dd" \
+            CODE_SIGNING_ALLOWED=NO \
+            CODE_SIGNING_REQUIRED=NO \
+            CODE_SIGN_IDENTITY="" \
+            CODE_SIGN_STYLE=Manual \
+            COMPILER_INDEX_STORE_ENABLE=NO \
+            2>&1 | tail -300
+
+      - name: 打包成未签名 IPA
+        run: |
+          set -euo pipefail
+          ARCHIVE="$RUNNER_TEMP/build/App.xcarchive"
+          APP="$(find "$ARCHIVE/Products/Applications" -maxdepth 1 -name '*.app' -print -quit)"
+          [ -n "$APP" ] || { echo "::error::archive 无 .app"; exit 1; }
+          mkdir -p "$RUNNER_TEMP/out/Payload"
+          ditto "$APP" "$RUNNER_TEMP/out/Payload/$(basename "$APP")"
+          cd "$RUNNER_TEMP/out"
+          zip -qry "小宇Folia-0.7.29-unsigned.ipa" Payload
+          rm -rf Payload
+          ls -lh *.ipa
+
+      - name: 校验未签名
+        run: |
+          set -euo pipefail
+          IPA="$RUNNER_TEMP/out/小宇Folia-0.7.29-unsigned.ipa"
+          unzip -l "$IPA" | head -20
+          if unzip -l "$IPA" | grep -qE '_CodeSignature/|embedded.mobileprovision'; then
+            echo "::error::产物含签名痕迹"; exit 1
+          fi
+          echo "✅ 未签名 IPA"
+
+      - name: 上传 Artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: xiaoyu-folia-ipa
+          path: ${{ runner.temp }}/out/*.ipa
+          if-no-files-found: error
+          retention-days: 30
+
+      - name: 发布 Release
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          set -euo pipefail
+          IPA="$RUNNER_TEMP/out/小宇Folia-0.7.29-unsigned.ipa"
+          TAG="xiaoyu-$(date -u +%Y%m%d-%H%M%S)"
+          gh release create "$TAG" "$IPA" \
+            --title "小宇Folia 0.7.29 未签名 IPA" \
+            --notes "官方 folia 0.7.29 + iOS 直连层（网易云本地 eapi/weapi 加密，零后端可听歌）。未签名 IPA：TrollStore 直接导入，或 Sideloadly/AltStore + 免费 Apple ID 自签（7 天）。" \
+            --latest
+          echo "下载: ${{ github.server_url }}/${{ github.repository }}/releases/tag/$TAG"
diff --git a/capacitor.config.ts b/capacitor.config.ts
new file mode 100644
index 0000000..5aa3255
--- /dev/null
+++ b/capacitor.config.ts
@@ -0,0 +1,24 @@
+// capacitor.config.ts
+// 小宇专属版 Folia for iOS (iPhone/iPad) — Capacitor 原生壳配置。
+// Web 层保持 Vite 构建产物 dist/ 原样；网易云走本地 eapi/weapi 直连，零后端可听歌。
+import type { CapacitorConfig } from '@capacitor/cli';
+
+const config: CapacitorConfig = {
+  appId: 'com.xiaoyu.folia',
+  appName: '小宇Folia',
+  webDir: 'dist',
+  backgroundColor: '#09090b',
+  ios: {
+    // WebView 约束到 safeAreaLayoutGuide，不进入状态栏/主指示条区域，避免双重留白。
+    contentInset: 'never',
+    backgroundColor: '#09090b',
+  },
+  plugins: {
+    // 网易云直连：用原生 URLSession 发请求，绕过 WKWebView 的 CORS；Cookie 由业务层自行管理。
+    CapacitorHttp: {
+      enabled: true,
+    },
+  },
+};
+
+export default config;
